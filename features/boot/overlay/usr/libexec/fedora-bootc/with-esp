#!/usr/bin/bash
#
# Mounts the ESP that systemd-boot started this boot from (its
# LoaderDevicePartUUID) on a directory in /run, runs COMMAND with each {} in
# its arguments replaced by that directory, then unmounts it. The ESP is not
# mounted otherwise: bootc mounts it only while it writes to it.
#
#   with-esp COMMAND [ARG...]
#
# For units with PrivateMounts=yes (secureboot-keys.service,
# systemd-boot-update.service), so that the mount is in the unit's own mount
# namespace and goes with it, also when this is killed.
set -euo pipefail

[ $# -gt 0 ] || { echo "usage: with-esp COMMAND [ARG...]" >&2; exit 2; }

# Four bytes of attributes, then the partition UUID in UTF-16LE.
var=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
uuid=$(tail -c +5 "$var" | iconv -f UTF-16LE -t ASCII | tr -d '\0' | tr '[:upper:]' '[:lower:]')
[[ $uuid =~ ^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$ ]] ||
    { echo "LoaderDevicePartUUID is not a partition UUID: '$uuid'" >&2; exit 1; }
dev=/dev/disk/by-partuuid/$uuid
udevadm wait --timeout=30 "$dev"
esp=$(mktemp -d -p /run esp.XXXXXX)
trap 'rmdir "$esp" || :' EXIT
mount -t vfat -o nosuid,nodev,noexec,noatime,fmask=0177,dmask=0077 "$dev" "$esp"
trap 'umount "$esp" || :; rmdir "$esp" || :' EXIT
test -d "$esp/EFI" || { echo "$dev is not an ESP (no EFI/)" >&2; exit 1; }

args=()
for arg in "$@"; do
    args+=("${arg//\{\}/$esp}")
done
"${args[@]}"
