#!/usr/bin/bash
#
# Puts the image's Secure Boot enrollment sets
# (/usr/lib/bootc/install/secureboot-keys/<set>/, image/enroll.sh) on the ESP,
# in loader/keys/<set>/, where systemd-boot offers "Enroll Secure Boot keys:
# <set>" while the firmware is in Setup Mode (docs/secureboot-tpm2.md). `bootc
# install` copies them too, but only when it installs: this brings them to
# machines installed before, and the sets of a later image (new keys) to
# every machine. The ESP is mounted read-write at every boot, and a set is
# written only when it differs.
#
#   secureboot-keys DIR   the ESP is mounted at DIR
#
# Run by secureboot-keys.service at every boot, which mounts the ESP
# systemd-boot started from for it (usr/libexec/fedora-bootc/with-esp).
set -euo pipefail
shopt -s nullglob

src=/usr/lib/bootc/install/secureboot-keys
# Sets an earlier image shipped and a later one no longer does, removed from
# the ESP so that their keys are not offered any more. A set's directory is
# only ever removed when it is named here.
retired=()

# fedora-bootc-only stops the firmware of add-in cards (option ROMs: a
# graphics card's, which gives the picture before the OS, a network or
# storage card's), so a machine whose boot ran some is not offered it, the
# check sbctl makes before enrolling without Microsoft's keys. The TPM event
# log records each as EV_EFI_BOOT_SERVICES_DRIVER (0x80000004) in PCR 2: the
# first 8 bytes of such an event. Without a TPM there is nothing to go by.
eventlog=/sys/kernel/security/tpm0/binary_bios_measurements
oproms=
# od writes every byte as " xx", so a match that starts with a space starts
# on a byte boundary.
ran_oproms() {
    local hex
    hex=$(od -An -tx1 -v "$1" | tr -d '\n') || return 1
    [[ $hex == *' 02 00 00 00 04 00 00 80'* ]]
}
if [ -r "$eventlog" ] && ran_oproms "$eventlog"; then
    oproms=1
    retired+=(fedora-bootc-only)
fi

esp=${1:?usage: secureboot-keys DIR}
test -d "$esp/EFI" || { echo "$esp is not an ESP (no EFI/)" >&2; exit 1; }

for name in "${retired[@]}"; do
    if [ -d "$esp/loader/keys/$name" ]; then
        rm -rf -- "${esp:?}/loader/keys/$name"
        sync -f "$esp/loader"
        echo "$name: removed from the ESP"
    fi
done
[ -z "$oproms" ] ||
    echo "fedora-bootc-only: not offered, the firmware of an add-in card ran at boot (option ROM), which that set would stop"

for set in "$src"/*/; do
    set=${set%/} name=${set##*/}
    case " ${retired[*]} " in *" $name "*) continue ;; esac
    dst=$esp/loader/keys/$name
    # The same .auth files, byte for byte, and no others: nothing to do.
    same=1
    for f in "$set"/*.auth; do cmp -s "$f" "$dst/${f##*/}" || same=0; done
    for f in "$dst"/*.auth; do [ -e "$set/${f##*/}" ] || same=0; done
    [ "$same" = 0 ] || continue
    # Each file under a temporary name first, on disk before it is renamed
    # over the old one, so that none is ever half written; a power cut
    # between two renames leaves the set mixed until the next boot puts it
    # right. systemd-boot reads only PK.auth, KEK.auth, db.auth and dbx.auth,
    # so a leftover .*.new is harmless and replaced next time.
    mkdir -p "$dst"
    for f in "$set"/*.auth; do cp "$f" "$dst/.${f##*/}.new"; done
    sync -- "$dst"/.*.auth.new
    for f in "$set"/*.auth; do mv -f "$dst/.${f##*/}.new" "$dst/${f##*/}"; done
    for f in "$dst"/*.auth; do [ -e "$set/${f##*/}" ] || rm -f "$f"; done
    sync -f "$dst"
    echo "$name: written to the ESP, loader/keys/$name/"
done
